# Copy to .env and edit. Docker Compose reads it automatically; Podman Compose too.

# Where the container's port is published, and how devices reach Pi Pocket.
# Use PI_POCKET_BIND=127.0.0.1 to keep it on this machine only.
PI_POCKET_BIND=0.0.0.0
PI_POCKET_PORT=8787
# local | lan | cloudflare | tailscale
PI_POCKET_ACCESS=lan

# External folders on the host. Relative paths are relative to docker-compose.yml.
PI_POCKET_DATA=./data
PI_POCKET_EXTENSIONS=./data/extensions
PI_POCKET_THEMES=./data/themes
PI_POCKET_PI_DIR=./data/pi
PI_POCKET_WORKSPACE=./data/workspace

# Chromium flags inside the container. Keep --no-sandbox when running as root.
PI_POCKET_BROWSER_ARGS=--no-sandbox --disable-dev-shm-usage

# Provider keys, if you do not sign in from the app (they are optional):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
